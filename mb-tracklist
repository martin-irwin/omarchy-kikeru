#!/usr/bin/env python3
"""Look up an official tracklist on MusicBrainz.

  mb-tracklist --album "..." [--artist "..."] --count N

Prints one "position<TAB>title" line per track and exits 0, or exits non-zero
with a reason on stderr. Refuses to answer unless a release's track count
matches --count exactly: titles applied by position are only safe when the
tracklists are the same length, and a wrong match is worse than no match.

MusicBrainz asks for a descriptive User-Agent and at most one request a
second. Both are honoured; this makes two requests.
"""
import argparse, json, sys, time, unicodedata, urllib.parse, urllib.request

UA = "kikeru/1.1 ( https://github.com/martin-irwin/omarchy-kikeru )"
BASE = "https://musicbrainz.org/ws/2"


def get(path, params, timeout, attempts=4):
    """MusicBrainz throttles by dropping connections as well as by 503, so a
    single failure says nothing about whether the data is there. Back off and
    ask again rather than reporting the release as missing."""
    url = f"{BASE}/{path}?" + urllib.parse.urlencode({**params, "fmt": "json"})
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    last = None
    for i in range(attempts):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.load(r)
        except Exception as e:
            last = e
            if i + 1 < attempts:
                time.sleep(1.5 * (i + 1))
    raise last


def norm(s):
    """Compare names without being defeated by width, case or punctuation."""
    s = unicodedata.normalize("NFKC", s or "").casefold()
    return "".join(c for c in s if c.isalnum())


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--album", required=True)
    ap.add_argument("--artist", default="")
    ap.add_argument("--count", type=int, required=True)
    ap.add_argument("--timeout", type=float, default=15.0)
    a = ap.parse_args()

    query = f'release:"{a.album}"'
    if a.artist:
        query += f' AND artist:"{a.artist}"'

    try:
        found = get("release", {"query": query, "limit": "10"}, a.timeout)
    except Exception as e:
        sys.exit(f"musicbrainz search failed: {e}")

    releases = found.get("releases", [])
    if not releases:
        sys.exit("no release matched")

    # Only releases whose length matches; then the best-scoring, and among
    # equals the earliest, which is the original rather than a reissue.
    cands = [r for r in releases if r.get("track-count") == a.count]
    if not cands:
        sys.exit(f"no release with {a.count} tracks (best had "
                 f"{releases[0].get('track-count')})")

    if a.artist:
        want = norm(a.artist)
        same = [r for r in cands
                if any(norm(c.get("artist", {}).get("name")) == want
                       for c in r.get("artist-credit", []))]
        if same:
            cands = same

    cands.sort(key=lambda r: (-int(r.get("score", 0)), r.get("date") or "9999"))
    best = cands[0]

    time.sleep(1.1)  # MusicBrainz rate limit
    try:
        rel = get(f"release/{best['id']}", {"inc": "recordings"}, a.timeout)
    except Exception as e:
        sys.exit(f"musicbrainz release fetch failed: {e}")

    tracks = [t for m in rel.get("media", []) for t in m.get("tracks", [])]
    if len(tracks) != a.count:
        sys.exit(f"release has {len(tracks)} tracks, expected {a.count}")

    artist = ", ".join(c["artist"]["name"] for c in rel.get("artist-credit", [])
                       if isinstance(c, dict) and "artist" in c)
    print(f"# {rel.get('title')}\t{artist}\t{rel.get('date','')}", file=sys.stderr)
    for t in tracks:
        print(f"{int(t['position'])}\t{t['title']}")


main()
