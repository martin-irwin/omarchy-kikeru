#!/usr/bin/env bash
# kill-tree <pid> [signal] -- terminate a process and every descendant under it.
#
# Cancelling a download has to reach three processes: this plugin's script, the
# yt-dlp it spawned, and the ffmpeg yt-dlp spawned in turn. Signalling the script
# alone is not enough, and its own signal trap cannot be relied on to finish the
# job -- while yt-dlp is converting, the script sits blocked in `read` with no
# output to wake it, so bash cannot service the trap before the process dies.
#
# Doing the walk from a separate process sidesteps that entirely. Children are
# killed before their parent so nothing gets a chance to be re-parented and
# carry on running unattended.
#
# Killing by process *group* would be the one-liner here, but the script shares
# its group with the shell that launched it -- that would take the whole bar down.

set -u

pid="${1:-}"
sig="${2:-TERM}"

[ -n "$pid" ] || { echo "usage: kill-tree <pid> [signal]" >&2; exit 2; }
[[ "$pid" =~ ^[0-9]+$ ]] || { echo "kill-tree: not a pid: $pid" >&2; exit 2; }

kill_tree() {
  local target="$1" child
  for child in $(pgrep -P "$target" 2>/dev/null); do
    kill_tree "$child"
  done
  kill -"$sig" "$target" 2>/dev/null
}

kill_tree "$pid"
exit 0
