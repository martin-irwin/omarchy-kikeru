#!/usr/bin/env bash
args="$*"; dest=""; prev=""; chapdest=""
# Exact-match the flag: "--progress-template" contains "--progress" as a
# substring, so a glob test here would always be true and never notice the
# flag going missing.
want_progress=0
for a in "$@"; do [ "$a" = "--progress" ] && want_progress=1; done
for a in "$@"; do [ "$prev" = "-P" ] && dest="$a"; prev="$a"; done
# grab the chapter output template's directory
for a in "$@"; do [[ "$a" == chapter:* ]] && chapdest="$(dirname "${a#chapter:}")"; done

if [[ "$args" == *--flat-playlist* && "$args" == *--dump-single-json* ]]; then
  python3 - <<'JSON'
import json
titles = ["Cornelius - Mic Check", "Cornelius - The Micro Disneycal World Tour (Official Audio)",
          "Cornelius - New Music Machine", "Count Five Or Six", "Clash", "Star Fruits Surf Rider",
          "Chapter 8 - Seashore and Horizon", "Free Fall", "Thank You For The Music", "Fantasma"]
e = [{"title": t, "uploader": "Cornelius"} for t in titles]
e[0]["upload_date"] = "19970806"
print(json.dumps({"title": "Fantasma (Full Album)", "entries": e}))
JSON
  exit 0
fi

if [[ "$args" == *--dump-single-json* ]]; then
  echo '{"title":"Miles Davis - Kind of Blue (Full Album) [HQ]","uploader":"Jazz Vault","upload_date":"19590817","chapters":[{"title":"So What"},{"title":"Freddie Freeloader"},{"title":"Blue in Green"}]}'
  exit 0
fi

if [[ "$args" == *--split-chapters* ]]; then
  i=0
  while IFS= read -r t; do
    i=$((i+1)); f=$(printf '%s/%02d - %s.mp3' "$chapdest" "$i" "$t")
    echo "fake" > "$f"; echo "[SplitChapters] Chapter $i; Destination: $f"
  done <<'T'
So What
Freddie Freeloader
Blue in Green
T
  exit 0
fi

if [[ "$args" == *after_move* ]]; then
  i=0
  while IFS= read -r t; do
    i=$((i+1))
    # Real yt-dlp zero-pads playlist_index to the width of the playlist. That
    # padding is what made bash printf read "08" as a bad octal number.
    idx=$(printf '%02d' "$i")
    f="$dest/$idx - $t.mp3"
    echo "fake" > "$f"
    [ "$want_progress" = 1 ] && printf '@PROG@ %d.0%%|1.00MiB/s|00:0%d\n' "$((i*10))" "$i"
    printf '@FILE@%s|%s|%s\n' "$idx" "$t" "$f"
  done <<'T'
Cornelius - Mic Check
Cornelius - The Micro Disneycal World Tour (Official Audio)
Cornelius - New Music Machine
Count Five Or Six
Clash
Star Fruits Surf Rider
Chapter 8 - Seashore and Horizon
Free Fall
Thank You For The Music
Fantasma
T
  exit 0
fi
exit 0
